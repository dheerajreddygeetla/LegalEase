# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/legalease

# Auth — generate a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=30d

# Google Sign-In (OAuth 2.0 Client ID from Google Cloud Console).
# Required for POST /api/auth/google to work; the endpoint is disabled
# without it rather than accepting unverified identities.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# AI (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
MAX_UPLOAD_MB=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_MAX=30
